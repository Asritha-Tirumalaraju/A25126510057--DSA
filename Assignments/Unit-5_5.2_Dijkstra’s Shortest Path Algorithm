#include <stdio.h>
#define MAX 20

int main()
{
    int cost[MAX][MAX], dist[MAX], visited[MAX], n, src, i, j, u, min;

    printf("Enter number of vertices (cities) n (1 to %d): ", MAX);
    scanf("%d", &n);
    if (n < 1 || n > MAX) 
{ 
      printf("Invalid n\n");
      return 0;
}

    printf("Enter weighted adjacency matrix (%d x %d, 0 if no road):\n", n, n);
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &cost[i][j]);
    printf("Enter source vertex (0 to %d): ", n - 1);
    scanf("%d", &src);
    if (src < 0 || src >= n) { 
printf("Invalid source vertex\n"); 
return 0; }

    for (i = 0; i < n; i++) {
        visited[i] = 0;
        dist[i] = (cost[src][i] != 0) ? cost[src][i] : -1;
    }
    dist[src] = 0;
    visited[src] = 1;
    for (i = 1; i < n; i++) {
        u = -1;
        min = 0;
        for (j = 0; j < n; j++) /* nearest reachable unvisited vertex */
            if (!visited[j] && dist[j] != -1 && (u == -1 || dist[j] < min)) {
                min = dist[j];
                u = j;
            }
        if (u == -1) break; /* remaining vertices unreachable */
        visited[u] = 1;
        for (j = 0; j < n; j++) /* relax edges from u */
            if (!visited[j] && cost[u][j] != 0 &&(dist[j] == -1 || dist[u] + cost[u][j] < dist[j]))
                dist[j] = dist[u] + cost[u][j];
    }

    printf("\nShortest distances from source vertex %d:\n", src);
    printf("Destination Distance\n");
    for (i = 0; i < n; i++) {
        if (dist[i] == -1)
          printf("%6d Unreachable\n", i);
        else 
           printf("%6d %d\n", i, dist[i]);
    }
    return 0;
}

