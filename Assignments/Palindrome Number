class Solution {
    public boolean isPalindrome(int x) {
        int n1,r,sum=0;
        n1=x;
        if(x<0)
        return false;
        while(x!=0)
        {
            r=x%10;
            sum=sum*10+r;
            x=x/10;
        }
        if(sum==n1)
         return true;
        else
         return false;


    }
}
