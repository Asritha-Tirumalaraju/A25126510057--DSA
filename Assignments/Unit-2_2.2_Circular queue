#include <stdio.h>
#define SIZE 5
 
int queue[SIZE];
int front = -1, rear = -1;
 
int isFull()  { return front == (rear + 1) % SIZE; }
int isEmpty() { return front == -1; }
 
void enqueue(int x) {
    if (isFull()) {
        printf("Queue OVERFLOW! Cannot insert %d.\n", x);
        return;
    }
    if (isEmpty())
        front = 0;
    rear = (rear + 1) % SIZE;
    queue[rear] = x;
    printf("Request %d inserted at position %d.\n", x, rear);
}
 
void dequeue() {
    int x;
    if (isEmpty()) {
        printf("Queue UNDERFLOW! No request to delete.\n");
        return;
    }
    x = queue[front];
    printf("Request %d deleted from position %d.\n", x, front);
    if (front == rear)
        front = rear = -1;
    else
        front = (front + 1) % SIZE;
}
 
void display() {
    int i;
    if (isEmpty()) {
        printf("Queue is empty.\n");
        return;
    }
    printf("Queue contents (front -> rear): ");
    i = front;
    while (1) {
        printf("%d ", queue[i]);
        if (i == rear)
            break;
        i = (i + 1) % SIZE;
    }
    printf("\nfront = %d, rear = %d\n", front, rear);
}
 
int main() {
    int choice, x;
    do {
        printf("\n1.Insert  2.Delete  3.Display  4.Exit\nEnter choice: ");
        scanf("%d", &choice);
        switch (choice) {
            case 1:
                printf("Enter request number: ");
                scanf("%d", &x);
                enqueue(x);
                break;
            case 2:
                dequeue();
                break;
            case 3:
                display();
                break;
            case 4:
                printf("Exiting program.\n");
                break;
            default:
                printf("Invalid choice!\n");
        }
    } while (choice != 4);
    return 0;
}
